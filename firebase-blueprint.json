{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "Dynasty Digital CRM client or lead entity",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "businessName": { "type": "string", "maxLength": 200 },
        "contactName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "website": { "type": "string", "maxLength": 200 },
        "address": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 100 },
        "industry": { "type": "string", "maxLength": 100 },
        "leadSource": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 },
        "tags": { "type": "array" },
        "dateAdded": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 5000 },
        "accessInfo": { "type": "string", "maxLength": 5000 },
        "archived": { "type": "boolean" },
        "lastActivityDate": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "businessName", "status"]
    },
    "ClientService": {
      "title": "ClientService",
      "description": "Active retainer or service contracted by a client",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "catalogItemId": { "type": "string", "maxLength": 128 },
        "customName": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "billingType": { "type": "string", "enum": ["one-time", "monthly"] },
        "price": { "type": "number" },
        "setupFee": { "type": "number" },
        "discountType": { "type": "string", "enum": ["percent", "fixed"] },
        "discountValue": { "type": "number" },
        "startDate": { "type": "string", "maxLength": 50 },
        "minimumTermMonths": { "type": "number" },
        "endDate": { "type": "string", "maxLength": 50 },
        "autoRenew": { "type": "boolean" },
        "status": { "type": "string", "maxLength": 50 },
        "billingDayOfMonth": { "type": "number" },
        "adSpendBudget": { "type": "number" },
        "notes": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "clientId", "customName", "price", "billingType", "status"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment transaction or invoice record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "clientServiceId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "date": { "type": "string", "maxLength": 50 },
        "method": { "type": "string", "maxLength": 50 },
        "type": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 50 },
        "invoiceNumber": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "clientId", "amount", "date", "status"]
    },
    "Project": {
      "title": "Project",
      "description": "Website build project milestone",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "stage": { "type": "string", "maxLength": 50 },
        "mockupDue": { "type": "string", "maxLength": 50 },
        "targetLaunch": { "type": "string", "maxLength": 50 },
        "depositPaid": { "type": "boolean" },
        "finalPaid": { "type": "boolean" },
        "previewLink": { "type": "string", "maxLength": 500 },
        "liveLink": { "type": "string", "maxLength": 500 },
        "notes": { "type": "string", "maxLength": 2000 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "clientId", "name", "stage"]
    },
    "Task": {
      "title": "Task",
      "description": "Agency actionable task or follow-up item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "dueDate": { "type": "string", "maxLength": 50 },
        "priority": { "type": "string", "maxLength": 50 },
        "done": { "type": "boolean" },
        "type": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "autoGenerated": { "type": "boolean" }
      },
      "required": ["id", "title", "dueDate", "done"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Client interaction timeline entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "timestamp": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "clientId", "type", "title", "timestamp"]
    },
    "ServiceCatalogItem": {
      "title": "ServiceCatalogItem",
      "description": "Pre-configured agency service offering",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "billingType": { "type": "string", "enum": ["one-time", "monthly"] },
        "defaultPrice": { "type": "number" },
        "setupFee": { "type": "number" },
        "minimumTermMonths": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "category", "billingType", "defaultPrice"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Dynasty Digital agency settings",
      "type": "object",
      "properties": {
        "agencyName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "website": { "type": "string", "maxLength": 200 },
        "location": { "type": "string", "maxLength": 200 },
        "defaultBillingDay": { "type": "number" },
        "pinEnabled": { "type": "boolean" },
        "pinCode": { "type": "string", "maxLength": 10 }
      },
      "required": ["agencyName"]
    },
    "AllowedUser": {
      "title": "AllowedUser",
      "description": "Authorized agency owner record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["owner"] }
      },
      "required": ["uid", "email", "role"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Agency operational or client-linked expense",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 50 },
        "vendor": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["Software/Tools", "Hosting", "Subcontractor", "Ads for Dynasty Digital", "Equipment", "Insurance", "Fees", "Other"] },
        "amount": { "type": "number" },
        "recurring": { "type": "string", "enum": ["monthly", "yearly", "one-time"] },
        "clientId": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 1000 },
        "receiptLink": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "date", "vendor", "category", "amount", "recurring"]
    },
    "ClientPerformanceEntry": {
      "title": "ClientPerformanceEntry",
      "description": "Monthly performance entry tracking ad spend, leads, CPL, booked jobs, revenue, ROAS, and GBP metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "clientId": { "type": "string", "maxLength": 128 },
        "month": { "type": "string", "maxLength": 20 },
        "adSpend": { "type": "number" },
        "leads": { "type": "number" },
        "costPerLead": { "type": "number" },
        "bookedJobs": { "type": "number" },
        "revenueFromAds": { "type": "number" },
        "roas": { "type": "number" },
        "gbpCalls": { "type": "number" },
        "gbpDirectionRequests": { "type": "number" },
        "gbpWebsiteClicks": { "type": "number" },
        "whatWeChanged": { "type": "string", "maxLength": 3000 },
        "nextMonthPlan": { "type": "string", "maxLength": 3000 },
        "notes": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "clientId", "month", "adSpend", "leads"]
    }
  },
  "firestore": {
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/Client" },
      "description": "Collection of client and lead accounts"
    },
    "/clientServices/{serviceId}": {
      "schema": { "$ref": "#/entities/ClientService" },
      "description": "Client contracted services and retainers"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Payment records and invoice ledger"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Website build milestones and design phases"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Agency workflow tasks and follow-ups"
    },
    "/activities/{activityId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Communication log entries and timeline"
    },
    "/catalog/{catalogId}": {
      "schema": { "$ref": "#/entities/ServiceCatalogItem" },
      "description": "Service catalog templates"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Agency settings document"
    },
    "/allowed_users/{userId}": {
      "schema": { "$ref": "#/entities/AllowedUser" },
      "description": "Authorized agency owner account entry"
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Agency expenses and cost tracking"
    },
    "/performanceEntries/{entryId}": {
      "schema": { "$ref": "#/entities/ClientPerformanceEntry" },
      "description": "Client monthly performance and advertising metrics"
    }
  }
}
